---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const areaOrder = ['Physics', 'Mathematics', 'Computing', 'Culture & Media'] as const;
const statusMark = { seed: '○', growing: '◐', evergreen: '●' };
const areaId = (area: string) => area.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const areas = areaOrder
  .map((area) => {
    const areaNotes = notes.filter((note) => note.data.area === area);
    const subtopics = [...new Set(areaNotes.flatMap((note) => note.data.topics))]
      .sort((a, b) => a.localeCompare(b));

    return { area, areaNotes, subtopics };
  })
  .filter(({ areaNotes }) => areaNotes.length > 0);
---

<BaseLayout title="Topics" description="Notes を大きな分野と個別テーマの二階層から辿るための地図。">
  <section class="index-intro">
    <p class="section-label">map / connections</p>
    <h1>Topics</h1>
    <p>
      Notes を時系列ではなく、大きな分野から辿るための地図です。<br />
      小トピックは各Noteの特徴を示すタグとして残し、同じNoteはArea内に一度だけ表示します。
    </p>
  </section>

  <div class="topic-map-list">
    {areas.map(({ area, areaNotes, subtopics }) => (
      <section class="topic-area" id={areaId(area)}>
        <div class="topic-area-head">
          <p>area</p>
          <h2>{area}</h2>
          <span>{areaNotes.length} note{areaNotes.length === 1 ? '' : 's'}</span>
        </div>

        <div class="topic-area-topics">
          <div class="index-topics" aria-label={`${area} subtopics`}>
            {subtopics.map((topic) => <span>#{topic}</span>)}
          </div>

          <div class="topic-note-links">
            {areaNotes.map((note) => (
              <a href={`/notes/${note.id}/`}>
                <span class={`status-text status-${note.data.status}`}>{statusMark[note.data.status]}</span>
                <strong>{note.data.title}</strong>
                <small>{note.data.summary}</small>
                <small>#{note.data.topics.join(' · #')}</small>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
