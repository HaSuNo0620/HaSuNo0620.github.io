---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { topicSlug } from '../lib/topics';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const areaOrder = ['Physics', 'Mathematics', 'Computing', 'Culture & Media'] as const;
const statusMark = { seed: '○', growing: '◐', evergreen: '●' };
const areaId = (area: string) => area.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const areas = areaOrder
  .map((area) => {
    const areaNotes = notes.filter((note) => note.data.area === area);
    const subtopics = [...new Set(areaNotes.flatMap((note) => note.data.topics))]
      .sort((a, b) => a.localeCompare(b));

    return { area, areaNotes, subtopics };
  })
  .filter(({ areaNotes }) => areaNotes.length > 0);
---

<BaseLayout title="Topics" description="Notes を大きな分野と個別テーマの二階層から辿るための地図。">
  <section class="index-intro">
    <p class="section-label">map / connections</p>
    <h1>Topics</h1>
    <p>
      Notes を時系列ではなく、大きな分野から辿るための地図です。<br />
      小トピックはリンクになっていて、選ぶとそのテーマに関係するNotesだけを辿れます。
    </p>
  </section>

  <div class="topic-map-list">
    {areas.map(({ area, areaNotes, subtopics }) => (
      <section class="topic-area" id={areaId(area)}>
        <div class="topic-area-head">
          <p>area</p>
          <h2>{area}</h2>
          <span>{areaNotes.length} note{areaNotes.length === 1 ? '' : 's'}</span>
        </div>

        <div class="topic-area-topics">
          <div class="index-topics subtopic-cloud" aria-label={`${area} subtopics`}>
            {subtopics.map((topic) => (
              <a class="topic-link" href={`/topics/${topicSlug(topic)}/`}>#{topic}</a>
            ))}
          </div>

          <div class="topic-note-list">
            {areaNotes.map((note) => (
              <article class="topic-note-entry">
                <div class="topic-note-entry-head">
                  <span class={`status-text status-${note.data.status}`}>{statusMark[note.data.status]}</span>
                  <a class="topic-note-title" href={`/notes/${note.id}/`}>{note.data.title}</a>
                </div>
                <p>{note.data.summary}</p>
                <div class="topic-note-meta">
                  {note.data.topics.map((topic) => (
                    <a class="topic-link" href={`/topics/${topicSlug(topic)}/`}>#{topic}</a>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .subtopic-cloud {
    padding: 16px 0 22px;
    border-bottom: 1px solid var(--line);
  }

  .topic-link {
    color: var(--accent);
    text-decoration: none;
  }

  .topic-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .topic-note-list {
    border-top: 0;
  }

  .topic-note-entry {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .topic-note-entry:last-child {
    border-bottom: 0;
  }

  .topic-note-entry-head {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 12px;
    align-items: baseline;
  }

  .topic-note-title {
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .topic-note-title:hover {
    color: var(--accent);
  }

  .topic-note-entry p {
    margin: 7px 0 10px 40px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.65;
  }

  .topic-note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-left: 40px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
  }
</style>
