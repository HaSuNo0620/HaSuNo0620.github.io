---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const statusLabel = { seed: '○ seed', growing: '◐ growing', evergreen: '● evergreen' };
const formatDate = (date: Date) => date.toLocaleDateString('ja-JP', {
  year: 'numeric', month: '2-digit', day: '2-digit',
}).replaceAll('/', '.');
---

<BaseLayout title="Notes" description="勉強、計算、実装、考察。完成した記事だけではなく途中の断片も含むノート。">
  <section class="index-intro">
    <p class="section-label">archive / growing</p>
    <h1>Notes</h1>
    <p>
      勉強したこと、試した計算、実装メモ、考察。<br />
      ○ は断片、◐ は育ち途中、● はある程度まとまったノートです。
    </p>
  </section>

  <div class="notes-index">
    {notes.map((note) => (
      <a class="index-row" href={`/notes/${note.id}/`}>
        <div class="index-date">{formatDate(note.data.publishedAt)}</div>
        <div class="index-body">
          <div class="index-title-line">
            <span class={`status-text status-${note.data.status}`}>{statusLabel[note.data.status]}</span>
            <h2>{note.data.title}</h2>
          </div>
          <p>{note.data.summary}</p>
          <div class="index-topics">{note.data.topics.map((topic) => <span>#{topic}</span>)}</div>
        </div>
        <div class="index-arrow">↗</div>
      </a>
    ))}
  </div>
</BaseLayout>
