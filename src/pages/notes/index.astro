---
import { isLegacyNote } from '../../lib/legacy-notes';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fields, fieldFor, revisionDate, formatDate } from '../../lib/fields';
import { topicSlug } from '../../lib/topics';
const notes=(await getCollection('notes',({id,data})=>!data.draft && !isLegacyNote(id))).sort((a,b)=>revisionDate(b.data).valueOf()-revisionDate(a.data).valueOf());
const states={seed:'構想・断片',growing:'執筆・検討中',evergreen:'まとまった記事'};
---
<BaseLayout title="記事一覧" description="分野、キーワード、更新日から記事を探す。">
  <section class="index-intro">
    <h1>記事一覧</h1>
    <p>理論、計算、考察、研究構想。分野やキーワードから探す。</p>
  </section>
  <section class="archive-controls" aria-label="記事の検索と絞り込み">
    <label class="search"><span>キーワード</span><input type="search" data-search placeholder="タイトル・概要・概念" /></label>
    <label><span>分野</span><select data-field><option value="">すべて</option>{fields.map(f=><option value={f.id}>{f.title}</option>)}</select></label>
    <label><span>状態</span><select data-status><option value="">すべて</option>{Object.entries(states).map(([id,title])=><option value={id}>{title}</option>)}</select></label>
    <label><span>並び順</span><select data-sort><option value="updated">更新順</option><option value="published">公開順</option></select></label>
    <button type="button" data-reset>条件を解除</button>
    <p data-count aria-live="polite">{notes.length} 件</p>
  </section>
  <div class="notes-index" data-index>
    {notes.map(note=>{
      const field=fieldFor(note.id,note.data.field);
      return <article class="index-row" data-row data-field-id={field?.id??''} data-state={note.data.status} data-search-text={[note.data.title,note.data.summary,...note.data.topics,field?.title??''].join(' ')} data-updated={revisionDate(note.data).valueOf()} data-published={note.data.publishedAt.valueOf()}>
        <div class="index-date">{formatDate(revisionDate(note.data))}</div>
        <div class="index-body"><h2><a href={`/notes/${note.id}/`}>{note.data.title}</a></h2><p>{note.data.summary}</p>
        <div class="index-topics">{field&&<a class="area-tag" href={`/fields/${field.id}/`}>{field.title}</a>}<span>{states[note.data.status]}</span>{note.data.topics.map(t=><a href={`/topics/${topicSlug(t)}/`}>#{t}</a>)}</div></div>
        <a class="index-arrow" href={`/notes/${note.id}/`} aria-label={`${note.data.title}を読む`}>↗</a>
      </article>;
    })}
  </div>
  <p data-empty hidden>条件に一致する記事がありません。</p>
</BaseLayout>
<script>
  const search=document.querySelector<HTMLInputElement>('[data-search]')!;
  const field=document.querySelector<HTMLSelectElement>('[data-field]')!;
  const status=document.querySelector<HTMLSelectElement>('[data-status]')!;
  const sort=document.querySelector<HTMLSelectElement>('[data-sort]')!;
  const rows=Array.from(document.querySelectorAll<HTMLElement>('[data-row]'));
  const index=document.querySelector<HTMLElement>('[data-index]')!;
  const count=document.querySelector<HTMLElement>('[data-count]')!;
  const empty=document.querySelector<HTMLElement>('[data-empty]')!;
  const normalize=(s:string)=>s.normalize('NFKC').toLocaleLowerCase();
  function apply(){
    const words=normalize(search.value).trim().split(/\s+/).filter(Boolean);
    let n=0;
    rows.forEach(row=>{
      const visible=(!field.value||row.dataset.fieldId===field.value)&&(!status.value||row.dataset.state===status.value)&&words.every(w=>normalize(row.dataset.searchText??'').includes(w));
      row.hidden=!visible;
      if(visible)n++;
    });
    const key=sort.value==='published'?'published':'updated';
    [...rows].sort((a,b)=>Number(b.dataset[key])-Number(a.dataset[key])).forEach(r=>index.append(r));
    count.textContent=`${n} / ${rows.length} 件`;
    empty.hidden=n!==0;
  }
  search.addEventListener('input',apply);
  [field,status,sort].forEach(el=>el.addEventListener('change',apply));
  document.querySelector('[data-reset]')?.addEventListener('click',()=>{search.value='';field.value='';status.value='';sort.value='updated';apply();});
  apply();
</script>
<style>
  .archive-controls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:2rem 0;padding:1.25rem 0;border-block:1px solid var(--line)}
  .search{grid-column:1/-1}
  label{display:grid;gap:.35rem;font-size:.85rem;color:var(--muted)}
  input,select{box-sizing:border-box;width:100%;padding:.65rem;background:var(--paper);color:var(--ink);border:1px solid var(--line);border-radius:6px;font:inherit}
  button{background:none;border:0;color:var(--accent);font:inherit;text-align:left;cursor:pointer;padding:0}
  [data-count]{grid-column:2/-1;text-align:right;margin:0;color:var(--muted)}
  [hidden]{display:none!important}
  @media(max-width:550px){.archive-controls{grid-template-columns:1fr 1fr}.search{grid-column:1/-1}[data-count]{grid-column:auto}}
</style>
