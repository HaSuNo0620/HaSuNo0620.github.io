---
import { isLegacyNote } from '../lib/legacy-notes';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {fields,revisionDate,formatDate} from '../lib/fields';
const recent=(await getCollection('notes',({id,data})=>!data.draft && !isLegacyNote(id))).sort((a,b)=>revisionDate(b.data).valueOf()-revisionDate(a.data).valueOf()).slice(0,5);
---
<BaseLayout>
<section class="home-hero"><h1>HaSuNo Garden</h1><p class="hero-copy">物理学、数学を中心とした研究と考察の記録。</p><div class="hero-links"><a href="/notes/">全記事一覧 →</a><a href="/topics/">概念索引 →</a></div></section>
<section class="garden-section"><h2>分野</h2><div class="fragment-list">{fields.map(f=><a class="fragment-row" href={`/fields/${f.id}/`}><span class="fragment-main"><strong>{f.title}</strong><small>{f.description}</small></span><span>↗</span></a>)}</div></section>
<section class="garden-section"><div class="section-heading"><h2>最近の更新</h2><a href="/updates/">更新履歴 →</a></div><div class="fragment-list">{recent.map(n=><a class="fragment-row" href={`/notes/${n.id}/`}><time datetime={revisionDate(n.data).toISOString()}>{formatDate(revisionDate(n.data))}</time><span class="fragment-main"><strong>{n.data.title}</strong><small>{n.data.summary}</small></span></a>)}</div></section>
</BaseLayout>
