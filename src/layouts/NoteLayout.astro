---
import BaseLayout from './BaseLayout.astro';
import { topicSlug } from '../lib/topics';

interface Props {
  title: string;
  summary: string;
  publishedAt: Date;
  updatedAt?: Date;
  area: 'Physics' | 'Mathematics' | 'Computing' | 'Culture & Media';
  topics: string[];
  status: 'seed' | 'growing' | 'evergreen';
}

const { title, summary, publishedAt, updatedAt, area, topics, status } = Astro.props;
const statusLabel = {
  seed: 'seed / 断片',
  growing: 'growing / 育ち途中',
  evergreen: 'evergreen / まとまり',
}[status];
const formatDate = (date: Date) => date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).replaceAll('/', '.');
const areaId = area.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<BaseLayout title={title} description={summary}>
  <article class="note-page">
    <header class="note-hero">
      <a class="back-link" href="/notes/">← all notes</a>
      <p class={`status status-${status}`}>{statusLabel}</p>
      <h1>{title}</h1>
      <p class="note-summary">{summary}</p>
      <div class="note-meta">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        {updatedAt && <span>updated {formatDate(updatedAt)}</span>}
        <a class="area-tag" href={`/topics/#${areaId}`}>{area}</a>
        {topics.map((topic) => (
          <a class="topic-link" href={`/topics/${topicSlug(topic)}/`}>#{topic}</a>
        ))}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="note-end">
      <span>∴</span>
      <a href="/notes/">Notes に戻る</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .topic-link {
    color: var(--accent);
    text-decoration: none;
  }

  .topic-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

<style is:global>
  /* Markdown の「画像だけの段落」を figure 相当として整える。 */
  .prose p:has(> img:only-child) {
    margin: 2.8rem 0 .65rem;
    padding: 14px 14px 10px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: color-mix(in srgb, var(--paper-2) 68%, transparent);
    overflow: hidden;
  }

  .prose p > img:only-child {
    display: block;
    width: 100%;
    max-width: 780px;
    height: auto;
    margin: 0 auto;
  }

  /* 現在の SVG は白背景を持つため、紙面へ自然に合成する。 */
  .prose p > img[src$='.svg']:only-child {
    mix-blend-mode: multiply;
  }

  /* 画像直後の斜体段落をキャプションとして扱う。 */
  .prose p:has(> img:only-child) + p:has(> em:only-child) {
    max-width: 720px;
    margin: 0 auto 2.9rem;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.75;
    text-align: center;
    letter-spacing: .01em;
  }

  .prose p:has(> img:only-child) + p:has(> em:only-child) em {
    font-style: normal;
  }

  @media (prefers-color-scheme: dark) {
    /* white -> black, black -> white としてから screen 合成し、
       SVG の白いキャンバスだけを暗い紙面へ馴染ませる。 */
    .prose p > img[src$='.svg']:only-child {
      filter: invert(1) hue-rotate(180deg);
      mix-blend-mode: screen;
    }
  }

  @media (max-width: 720px) {
    .prose p:has(> img:only-child) {
      margin-top: 2.2rem;
      padding: 8px 6px 6px;
      border-radius: 10px;
    }

    .prose p:has(> img:only-child) + p:has(> em:only-child) {
      margin-bottom: 2.3rem;
      padding-inline: 8px;
      font-size: 12px;
      text-align: left;
    }
  }
</style>
