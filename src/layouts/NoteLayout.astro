---
import BaseLayout from './BaseLayout.astro';
import { topicSlug } from '../lib/topics';

interface Props {
  title: string;
  summary: string;
  publishedAt: Date;
  updatedAt?: Date;
  area: 'Physics' | 'Mathematics' | 'Computing' | 'Culture & Media';
  topics: string[];
  status: 'seed' | 'growing' | 'evergreen';
}

const { title, summary, publishedAt, updatedAt, area, topics, status } = Astro.props;
const statusLabel = {
  seed: 'seed / 断片',
  growing: 'growing / 育ち途中',
  evergreen: 'evergreen / まとまり',
}[status];
const formatDate = (date: Date) => date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).replaceAll('/', '.');
const areaId = area.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<BaseLayout title={title} description={summary}>
  <article class="note-page">
    <header class="note-hero">
      <a class="back-link" href="/notes/">← all notes</a>
      <p class={`status status-${status}`}>{statusLabel}</p>
      <h1>{title}</h1>
      <p class="note-summary">{summary}</p>
      <div class="note-meta">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        {updatedAt && <span>updated {formatDate(updatedAt)}</span>}
        <a class="area-tag" href={`/topics/#${areaId}`}>{area}</a>
        {topics.map((topic) => (
          <a class="topic-link" href={`/topics/${topicSlug(topic)}/`}>#{topic}</a>
        ))}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="note-end">
      <span>∴</span>
      <a href="/notes/">Notes に戻る</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .topic-link {
    color: var(--accent);
    text-decoration: none;
  }

  .topic-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
