---
import BaseLayout from './BaseLayout.astro';
import { topicSlug } from '../lib/topics';

interface Props {
  field?: {id:string;title:string};
  prerequisites?: {id:string;title:string}[];
  related?: {id:string;title:string}[];
  title: string;
  summary: string;
  publishedAt: Date;
  updatedAt?: Date;
  area: 'Physics' | 'Mathematics' | 'Computing' | 'Economics' | 'Culture & Media';
  topics: string[];
  status: 'seed' | 'growing' | 'evergreen';
}

const { title, summary, publishedAt, updatedAt, area, topics, status, field, prerequisites=[], related=[] } = Astro.props;
const statusLabel = {
  seed: 'seed / 断片',
  growing: 'growing / 育ち途中',
  evergreen: 'evergreen / まとまり',
}[status];
const formatDate = (date: Date) => date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).replaceAll('/', '.');
const areaId = area.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<BaseLayout title={title} description={summary}>
  <article class="note-page">
    <header class="note-hero">
      <a class="back-link" href={field ? `/fields/${field.id}/` : "/notes/"}>← {field?.title ?? "全記事"}</a>
      <p class={`status status-${status}`}>{statusLabel}</p>
      <h1>{title}</h1>
      <p class="note-summary">{summary}</p>
      <div class="note-meta">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        {updatedAt && <span>updated {formatDate(updatedAt)}</span>}
        <a class="area-tag" href={`/topics/#${areaId}`}>{area}</a>
        {topics.map((topic) => (
          <a class="topic-link" href={`/topics/${topicSlug(topic)}/`}>#{topic}</a>
        ))}
      </div>
    </header>

    {prerequisites.length>0 && <aside><h2>前提となる記事</h2><ul>{prerequisites.map(n=><li><a href={`/notes/${n.id}/`}>{n.title}</a></li>)}</ul></aside>}
    <div class="prose">
      <slot />
    </div>

    {related.length>0 && <aside><h2>関連記事</h2><ul>{related.map(n=><li><a href={`/notes/${n.id}/`}>{n.title}</a></li>)}</ul></aside>}
    <footer class="note-end">
      <span>∴</span>
      <a href="/notes/">全記事一覧に戻る</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .topic-link {
    color: var(--accent);
    text-decoration: none;
  }

  .topic-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

<style is:global>
  /* Figure Style v1: figures are part of the paper, not white panels. */
  .prose p:has(> img:only-child) {
    margin: 2.8rem 0 .65rem;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .prose p > img:only-child {
    display: block;
    width: 100%;
    max-width: 780px;
    height: auto;
    margin: 0 auto;
  }

  /* Image-following emphasis is used as a figure caption in Markdown notes. */
  .prose p:has(> img:only-child) + p:has(> em:only-child) {
    max-width: 720px;
    margin: 0 auto 2.9rem;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.75;
    text-align: center;
    letter-spacing: .01em;
  }

  .prose p:has(> img:only-child) + p:has(> em:only-child) em {
    font-style: normal;
  }

  @media (max-width: 720px) {
    .prose p:has(> img:only-child) {
      margin-top: 2.2rem;
    }

    .prose p:has(> img:only-child) + p:has(> em:only-child) {
      margin-bottom: 2.3rem;
      padding-inline: 8px;
      font-size: 12px;
      text-align: left;
    }
  }
</style>
